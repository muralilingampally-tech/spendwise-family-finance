# Firebase web app config — Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Shared workspace: set the SAME value in both partners' deployments so you and
# your spouse see one set of data (e.g. "our-family").
VITE_FAMILY_ID=

# Optional access allow-list (comma separated). Only these emails can sign in.
VITE_ALLOWED_EMAILS=
