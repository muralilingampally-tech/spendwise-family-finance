rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow-list of the two accounts that share this workspace. Keep in sync
    // with VITE_ALLOWED_EMAILS / src/lib/firebase.ts.
    function allowed() {
      return request.auth != null &&
        request.auth.token.email in [
          'muralik0909@gmail.com',
          'gatlarajeshwari09@gmail.com'
        ];
    }

    // A user document is readable/writable only by its owner.
    match /users/{userId} {
      allow read, write: if allowed() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      allow read, write: if allowed();
      // Masters, transactions and the member directory.
      match /{document=**} {
        allow read, write: if allowed();
      }
    }
  }
}