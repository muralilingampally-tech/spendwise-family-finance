{
  "name": "SpendWise — Family Finance",
  "short_name": "SpendWise",
  "description": "Track family income, expenses, budgets and net worth.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7fbfa",
  "theme_color": "#0d8073",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Transactions", "url": "/transactions", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Budget", "url": "/budget", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
